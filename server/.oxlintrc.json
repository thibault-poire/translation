{
  "$schema": "./node_modules/oxlint/configuration_schema.json",

  "rules": {
    "no-console": "warn",
    "@typescript-eslint/no-explicit-any": "off",
    "@typescript-eslint/no-floating-promises": "warn"
  },

  "env": {
    "node": true,
    "vitest": true
  },

  "ignorePatterns": ["dist/**", "node_modules/**"]
}
